#: app_main/templates/app_main/index.html:8
msgid "Full-Stack Developer · 5+ years"
msgstr "Full-Stack разработчик · 5+ лет"

#: app_main/templates/app_main/index.html:10
msgid ""
"I'm <span class=\"italic text-accent\">Ulug'bek</span> — I build production-"
"grade web apps."
msgstr ""
"Я <span class=\"italic text-accent\">Улугбек</span> — создаю веб-приложения "
"промышленного уровня."

