# Copy to .env and fill in. Never commit the real .env.

# Core -----------------------------------------------------------------------
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=thedevu101.uz,www.thedevu101.uz
CSRF_TRUSTED_ORIGINS=https://thedevu101.uz,https://www.thedevu101.uz
SITE_DOMAIN=thedevu101.uz
SITE_URL=https://thedevu101.uz

# PostgreSQL (used when DEBUG=0) ---------------------------------------------
PGDATABASE=thedevu101
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=thedevu101
PGPASSWORD=change-me

# Social auth (leave blank to disable a provider) ----------------------------
GOOGLE_SOCIAL_KEY=
GOOGLE_SOCIAL_SECRET=
GITHUB_SOCIAL_KEY=
GITHUB_SOCIAL_SECRET=
LINKEDIN_SOCIAL_KEY=
LINKEDIN_SOCIAL_SECRET=

# Email (SMTP used when DEBUG=0) --------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=thedevu101 <no-reply@thedevu101.uz>

# Comma-separated list notified on new comments / reviews.
NOTIFY_EMAILS=thedevu101@gmail.com
